# Copy this file to .env and adjust as needed.

# SQLite file the backend reads/writes. Relative paths are resolved from
# wherever you launch uvicorn.
DATABASE_URL=sqlite:///./holo.db

# Comma-separated list of origins allowed to call this API (your frontend's
# dev/prod URL). The Next.js dev server default is included already.
CORS_ORIGINS=http://localhost:3000
